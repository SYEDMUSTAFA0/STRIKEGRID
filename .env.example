# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# STRIKEGRID online play (all optional — the game runs fully offline without them)
#
# Choose ONE backend. When neither is set, SECTOR 09 automatically falls back
# to BroadcastChannel transport (same-browser tabs) plus a simulated local
# presence list, so every menu/lobby feature still works for testing.
# ---------------------------------------------------------------------------

# --- Option A: Supabase (recommended — Auth + Postgres-backed presence) ---
# 1. Create a project at https://supabase.com
# 2. Project Settings → API → copy URL and anon/public key below.
# 3. In the SQL editor run the schema in README.md ("Online backend schema")
#    to create profiles, strikegrid_players + strikegrid_invites tables.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- Option B: Firebase (Auth + Realtime Database) ---
# 1. Create a project at https://console.firebase.google.com
# 2. Project settings → General → Your apps → Web app config → copy the
#    firebaseConfig values below.
# 3. Authentication → Sign-in method → enable Email/Password (and Google).
# 4. Realtime Database → create database → paste its URL below.
# 5. Apply the security rules in README.md ("Firebase RTDB rules").
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR-PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
VITE_FIREBASE_DATABASE_URL="https://YOUR-PROJECT-default-rtdb.firebaseio.com"

# --- Optional: external GLB/GLTF model upgrades ---
# Vehicles and enemies use fully procedural models by default. To let the game
# upgrade to real GLB/GLTF assets, set this to "true" and place the files in
# public/models/ (e.g. public/models/suv.glb, public/models/soldier_head.glb).
# Leave unset/false to keep the bundle free of external model URLs.
VITE_EXTERNAL_MODELS="false"
